{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samx-vm",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "samx-vm-db",
      "database_id": "d3d6315f-9cfb-494c-8796-3df2907655c2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "samx-vm-storage"
    }
  ]
}
